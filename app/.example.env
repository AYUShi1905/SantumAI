# Qdrant Vector DB
QDRANT_API_KEY=
QDRANT_URL=
COLLECTION_NAME=

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# Model Roles (GPT-4.1 Family)
MODEL_COUNSELING=gpt-4.1
MODEL_BACKGROUND=gpt-4.1-mini
MODEL_ROUTING=gpt-4.1-nano
MODEL_MODERATION=gpt-4.1-mini


# App Settings
PROJECT_NAME="Santum AI RAG Service"
DEBUG=False

# LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=santum-ai

# Embedding Rate Limiting
EMBEDDING_BATCH_SIZE=5
EMBEDDING_DELAY_SECONDS=10.0